"DecalModulate"
{
 
	$basetexture "decals/pool/blood_pool5"
 

 
	$decal 1
 

	$vertexcolor 1
	$vertexalpha 1

	"$decalscale" 0.25
	$forcealphawrite 1
	$forcerefract 0
	$nowritez 0
	$vertexcolormodulate 1
	$writez 1
}



