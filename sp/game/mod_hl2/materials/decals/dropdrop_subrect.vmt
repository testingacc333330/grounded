
"unlitgeneric"
{
 "$basetexture"  "decals/dropdrop"
 "$bumpmap"     "decals/dropdrop_nrm"
"$mraotexture"   "decals/dropdrop_nrm"
"$bumpmap" 	"decals/dropdrop_nrm"

"$envmap"	"env_cubemap"

"$useEnvAmbient"	"1"

"$alphatest"	"1"

"$translucent"	"1"
"$parallax"	"1"
"$parallaxdepth"	"60"

 "$surfaceprop"   "default"
 "$model"         "1"


	$decalscale 0.02
	$decalscalevariation 0.02
}


