"vertexlitgeneric"
{
	"$basetexture" "decals/flesh/animated/blood1"
	"$surfaceprop" "BloodyFlesh"
	"$surfaceprop2" "Default"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"$alphatest" "0,7"
	$decalscale 0.02
	$decalscalevariation 0.02
	$frame 0

	Proxies
	{
		AnimatedOffsetTexture
		{
			animatedtexturevar "$basetexture"
			animatedtextureframenumvar "$frame"
			animatedtextureframerate 16
		}
	}
}